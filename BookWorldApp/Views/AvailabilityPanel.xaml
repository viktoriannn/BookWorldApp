<UserControl x:Class="BookWorldApp.Views.AvailabilityPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <GroupBox Header="Наличие в магазинах сети">
        <DockPanel>
            <TextBlock DockPanel.Dock="Bottom"
                       Text="{Binding AvailabilityMessage}"
                       Style="{StaticResource Hint}"
                       Margin="0,6,0,0"/>
            <DataGrid Style="{StaticResource ReadOnlyGrid}" ItemsSource="{Binding Availability}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Магазин" Binding="{Binding ShopName}" Width="*"/>
                    <DataGridTextColumn Header="Экземпляров" Binding="{Binding Quantity}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </GroupBox>
</UserControl>
