<UserControl x:Class="BookWorld.Views.ChequePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">

    <GroupBox Header="Чек продажи" Style="{StaticResource AccentGroupBox}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding Cart.Lines}"
                      SelectedItem="{Binding SelectedCartLine}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Кол-во"
                                        Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                        Width="60"/>
                    <DataGridTextColumn Header="Цена, ₽" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="75" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Sum, StringFormat={}{0:N2}}" Width="80" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Итого:" Style="{StaticResource SummaryCaption}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Cart.Total, StringFormat='{}{0:N2} ₽'}"
                               Style="{StaticResource SummaryValue}"/>
                </Grid>

                <TextBlock Text="Для изменения количества выберите позицию в таблице."
                           Style="{StaticResource Hint}"/>

                <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Удалить позицию"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RemoveLineCommand}"/>
                    <Button Content="Очистить чек"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ClearCartCommand}"/>
                    <Button Content="Подтвердить продажу"
                            Style="{StaticResource PrimaryButtonFlush}"
                            Command="{Binding ConfirmSaleCommand}"/>
                </WrapPanel>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Количество для добавления"
                               Style="{StaticResource Label}"
                               VerticalAlignment="Center"/>
                    <xctk:IntegerUpDown Grid.Column="1" Value="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                    Minimum="1" 
                    Maximum="1000" Height="20" VerticalAlignment="Bottom" />
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Добавить в чек"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddToCartCommand}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </GroupBox>
</UserControl>
