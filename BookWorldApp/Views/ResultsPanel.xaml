<UserControl x:Class="BookWorldApp.Views.ResultsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <GroupBox Header="Найденные издания" Margin="0,0,0,8">
        <DataGrid Style="{StaticResource ReadOnlyGrid}"
                  ItemsSource="{Binding Results}"
                  SelectedItem="{Binding SelectedBook}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*"/>
                <DataGridTextColumn Header="Автор(ы)" Binding="{Binding Authors}" Width="1.5*"/>
                <DataGridTextColumn Header="Жанр" Binding="{Binding Genres}" Width="*"/>
                <DataGridTextColumn Header="Издательство" Binding="{Binding Publisher}" Width="*"/>
                <DataGridTextColumn Header="Цена, ₽" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="85"/>
                <DataGridTextColumn Header="Остаток" Binding="{Binding Stock}" Width="75"/>
            </DataGrid.Columns>
        </DataGrid>
    </GroupBox>
</UserControl>
