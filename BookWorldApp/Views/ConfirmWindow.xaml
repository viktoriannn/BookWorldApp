<Window x:Class="BookWorldApp.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение"
        Style="{StaticResource AppWindow}"
        Width="460"
        Height="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Border Padding="24">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Отмена"
                        Style="{StaticResource SecondaryButton}"
                        IsCancel="True"/>
                <Button Content="Удалить"
                        Style="{StaticResource DangerButton}"
                        IsDefault="True"
                        Click="Confirm_Click"/>
            </StackPanel>

            <TextBlock DockPanel.Dock="Top" Text="Подтверждение" Style="{StaticResource Title}" Margin="0,0,0,14"/>

            <TextBlock x:Name="MessageText" Style="{StaticResource Body}"/>
        </DockPanel>
    </Border>
</Window>
