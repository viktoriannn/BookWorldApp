<Window x:Class="BookWorldApp.Views.OrderCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Заказ на пополнение запасов"
        Style="{StaticResource AppWindow}"
        Width="680"
        Height="640"
        WindowStartupLocation="CenterOwner">

    <Border Padding="20">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom">
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FormError}" Margin="0,8,0,8"/>

                <Border Style="{StaticResource SummaryPanel}" Margin="0,0,0,12">
                    <DockPanel>
                        <TextBlock Text="Сумма заказа:" Style="{StaticResource SummaryCaption}"/>
                        <TextBlock Text="{Binding Cart.Total, StringFormat='{}{0:N2} ₽'}" Style="{StaticResource SummaryValue}"/>
                    </DockPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelCommand}"
                            IsCancel="True"/>
                    <Button Content="Создать заказ"
                            Style="{StaticResource PrimaryButtonFlush}"
                            Command="{Binding CreateCommand}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="Заказ на пополнение запасов" Style="{StaticResource Title}"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Магазин"
                   Style="{StaticResource Label}"/>
                        <TextBox Style="{StaticResource ReadOnlyInfoBox}"
                 Text="{Binding ShopName, Mode=OneWay}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Дата создания"
                   Style="{StaticResource Label}"/>
                        <TextBox Style="{StaticResource ReadOnlyInfoBox}"
                 Text="{Binding OrderDate, Mode=OneWay}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Книга *" Style="{StaticResource Label}"/>
                        <ComboBox ItemsSource="{Binding Books}"
                                  DisplayMemberPath="Title"
                                  SelectedItem="{Binding SelectedBook}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Количество *" Style="{StaticResource Label}"/>
                        <xctk:IntegerUpDown Grid.Column="1" 
                                            Minimum="1"
                                            Maximum="1000"
                                            Style="{StaticResource IntegerUpDownStyle}"
                                            Value="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,2">
                        <Button Content="Наличие в сети"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding CheckAvailabilityCommand}"/>
                        <Button Content="Добавить"
                                Style="{StaticResource PrimaryButtonFlush}"
                                Command="{Binding AddBookCommand}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding AvailabilityMessage}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Cart.Lines}" SelectedItem="{Binding SelectedLine}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Binding="{Binding Title, Mode=OneWay}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Кол-во"
                                        Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                        Width="65"/>
                    <DataGridTextColumn Header="Цена, ₽" Binding="{Binding Price, Mode=OneWay, StringFormat={}{0:N2}}" Width="75" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Sum, Mode=OneWay, StringFormat={}{0:N2}}" Width="85" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</Window>
