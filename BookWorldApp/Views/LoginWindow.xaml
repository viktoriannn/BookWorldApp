<Window x:Class="BookWorldApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BookWorld — Вход"
        Style="{StaticResource AppWindow}"
        Width="420"
        Height="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Border Padding="32">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="BookWorld" Style="{StaticResource BrandTitle}"/>
            <TextBlock Text="Вход в систему" Style="{StaticResource Subtitle}"/>

            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Логин" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="Пароль" Style="{StaticResource Label}"/>
                <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordInput_PasswordChanged"/>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FormError}"/>

            <Button Content="Войти"
                    Style="{StaticResource PrimaryButtonFlush}"
                    Command="{Binding LoginCommand}"
                    IsDefault="True"/>

            <TextBlock Text="Если вы забыли пароль, обратитесь к администратору."
                       Style="{StaticResource Footnote}"/>
        </StackPanel>
    </Border>
</Window>
